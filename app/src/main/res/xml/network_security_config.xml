<?xml version="1.0" encoding="utf-8"?>
<!-- Many public IPTV streams and channel logos are still served over plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
